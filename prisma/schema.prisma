generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  GUARD
  ADMIN
  SUPER_ADMIN
}

enum UserType {
  STAFF
  STUDENT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum RegistrationForm {
  BASIC
  ACADEMIC
}

enum PlanFeature {
  INFRACTIONS
  REPORTS
  QR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ROLE_CHANGE
  RESOLVE
  PLAN_CHANGE
  SUSPEND
  REACTIVATE
}

enum AuditEntity {
  ORGANIZATION
  USER
  VEHICLE
  PARKING_BLOCK
  INFRACTION
  PLAN
}

model Plan {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  maxUsers    Int?
  maxGuards   Int?
  maxBlocks   Int?
  maxVehicles Int?
  features    PlanFeature[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizations Organization[]
}

model Organization {
  id                  String             @id @default(cuid())
  slug                String             @unique
  name                String
  displayName         String
  logoUrl             String?
  brandColor          String?
  status              OrganizationStatus @default(ACTIVE)
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id])
  registrationForm    RegistrationForm   @default(BASIC)
  selfRegistration    Boolean            @default(true)
  allowedEmailDomains String[]           @default([])
  defaultBlockId      String?            @unique
  defaultBlock        ParkingBlock?      @relation("DefaultBlock", fields: [defaultBlockId], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  memberships   Membership[]
  vehicles      Vehicle[]
  blocks        ParkingBlock[] @relation("OrganizationBlocks")
  accessLogs    AccessLog[]
  infractions   Infraction[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  platformAdmin       Boolean   @default(false)
  phone               String?
  rut                 String?   @unique
  lastOrganizationId  String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships         Membership[]
  vehicles            Vehicle[]
  notifications       Notification[]
  accessLogs          AccessLog[]          @relation("UserAccess")
  guardLogs           AccessLog[]          @relation("GuardLogs")
  infractions         Infraction[]         @relation("UserInfractions")
  reportedInfractions Infraction[]         @relation("GuardInfractions")
  resolvedInfractions Infraction[]         @relation("ResolvedInfractions")
  resetTokens         PasswordResetToken[]
  auditLogs           AuditLog[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Membership {
  id                 String       @id @default(cuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role               Role
  active             Boolean      @default(true)
  credentialId       String?
  userType           UserType?
  position           String?
  department         String?
  academicDepartment String?
  career             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@unique([organizationId, credentialId])
  @@index([organizationId, role])
}

model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  plate          String
  make           String?
  model          String?
  color          String?
  authorized     Boolean      @default(true)
  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accessLogs     AccessLog[]
  infractions    Infraction[]
  currentBlockId String?
  currentBlock   ParkingBlock? @relation(fields: [currentBlockId], references: [id])

  @@unique([organizationId, plate])
  @@index([ownerId])
}

model ParkingBlock {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("OrganizationBlocks", fields: [organizationId], references: [id])
  name           String
  description    String?
  capacity       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  defaultOf  Organization? @relation("DefaultBlock")
  vehicles   Vehicle[]
  accessLogs AccessLog[]

  @@unique([organizationId, name])
}

enum AccessDirection {
  IN
  OUT
}

enum AccessMethod {
  PLATE
  QR
  CARD
  MANUAL
}

model AccessLog {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  vehicleId      String
  vehicle        Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation("UserAccess", fields: [userId], references: [id])
  guardId        String?
  guard          User?           @relation("GuardLogs", fields: [guardId], references: [id])
  method         AccessMethod
  direction      AccessDirection
  blockId        String?
  block          ParkingBlock?   @relation(fields: [blockId], references: [id])
  timestamp      DateTime        @default(now())
  authorized     Boolean         @default(true)
  note           String?

  @@index([organizationId, timestamp])
  @@index([vehicleId])
}

enum InfractionType {
  WRONG_BLOCK
  UNAUTHORIZED_ENTRY
  DOUBLE_PARKING
  EXPIRED_PERMIT
  BLOCKING_ACCESS
  SPEEDING
  OTHER
}

enum InfractionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model Infraction {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  vehicleId      String
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?            @relation("UserInfractions", fields: [userId], references: [id])
  guardId        String
  guard          User             @relation("GuardInfractions", fields: [guardId], references: [id])
  type           InfractionType
  description    String
  status         InfractionStatus @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  resolvedById String?
  resolvedBy   User?     @relation("ResolvedInfractions", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  resolution   String?
  evidenceUrl  String?

  @@index([organizationId, status])
  @@index([userId])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName      String
  action         AuditAction
  entity         AuditEntity
  entityId       String?
  detail         Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([createdAt])
}
