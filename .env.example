# Base de datos PostgreSQL (Neon) — la lee prisma/schema.prisma
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# JWT — cambiar por un secreto seguro en producción (mínimo 32 caracteres).
# Obligatoria en producción: si falta, el servidor no arranca (no hay fallback inseguro).
JWT_SECRET="cambia-esto-en-produccion-usa-openssl-rand-hex-32"
JWT_ISSUER="sigte.local"
JWT_AUDIENCE="sigte.app"

# Secreto para firmar los QR de acceso (HMAC-SHA256). Si falta, usa JWT_SECRET.
# Recomendado definir uno propio: openssl rand -hex 32
QR_SECRET=""

# Envío de email (recuperación de contraseña) vía Resend — resend.com
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"

# URL pública de la app, usada para armar el link del correo de reseteo
APP_URL="http://localhost:3000"

# Seed (prisma/seed.ts): en producción está bloqueado salvo ALLOW_PROD_SEED=true.
# SEED_PASSWORD sobreescribe las contraseñas demo (que son públicas en el repo).
ALLOW_PROD_SEED=""
SEED_PASSWORD=""
